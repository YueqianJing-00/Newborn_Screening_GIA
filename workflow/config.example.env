# Copy this file to config.env, replace each example path, and keep config.env
# outside version control.

# Executables
PLINK=plink
PLINK2=plink2
ADMIXTURE=admixture

# Shared parameters
K=5
REFERENCE_MAF=0.01
LD_WINDOW=1000
LD_STEP=100
LD_R2=0.2

# Global ancestry inputs and work directories
REFERENCE_BFILE=/path/to/1000g_phase3/all_phase3
REFERENCE_PSAM=/path/to/1000g_phase3/all_phase3.psam
AIM_LIST=/path/to/ancestry_informative_snps.txt
STUDY_VCF=/secure/path/to/study_genotypes.vcf.gz
GLOBAL_REFERENCE_WORK_DIR=/secure/work/global_reference
GLOBAL_JOINT_WORK_DIR=/secure/work/global_joint
