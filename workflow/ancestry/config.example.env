# Copy this file to config.env, replace each example path, and keep config.env
# outside version control.

# Executables
PLINK=plink
PLINK2=plink2
ADMIXTURE=admixture
BCFTOOLS=bcftools
TABIX=tabix
SHAPEIT4=shapeit4
RFMIX=rfmix

# Shared parameters
K=5
REFERENCE_MAF=0.01
LD_WINDOW=1000
LD_STEP=100
LD_R2=0.2

# Global ancestry inputs and work directories
REFERENCE_BFILE=/path/to/1000g_phase3/all_phase3
REFERENCE_PSAM=/path/to/1000g_phase3/all_phase3.psam
AIM_LIST=/path/to/ancestry_informative_snps.txt
STUDY_VCF=/secure/path/to/study_genotypes.vcf.gz
GLOBAL_REFERENCE_WORK_DIR=/secure/work/global_reference
GLOBAL_JOINT_WORK_DIR=/secure/work/global_joint

# Local ancestry inputs and work directories
QUERY_BFILE=/secure/path/to/local_ancestry_cohort
PHASED_REFERENCE_VCF=/path/to/1000g_phase3/phased.vcf.gz
GENETIC_MAP_PATTERN=/path/to/shapeit4/maps/chr%s.b37.gmap.gz
RFMIX_GENETIC_MAP=/path/to/rfmix/genetic_map_b37.txt
LOCAL_QUERY_WORK_DIR=/secure/work/local_query
LOCAL_REFERENCE_WORK_DIR=/secure/work/local_reference
LOCAL_PHASED_WORK_DIR=/secure/work/local_phased
LOCAL_RFMIX_WORK_DIR=/secure/work/local_rfmix
