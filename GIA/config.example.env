# Copy this file to config.env, replace each example path, and keep config.env
# outside version control. Install the required software, add it to PATH, and
# prepare the inputs before running the scripts.

# Shared parameters
K=5
REFERENCE_MAF=0.01
LD_WINDOW=1000
LD_STEP=100
LD_R2=0.2
REFERENCE_THRESHOLD=0.80
VARIANT_ID_TEMPLATE='@:#:$r:$a'

# Global ancestry inputs
REFERENCE_BFILE=/path/to/1000g_phase3/all_phase3
REFERENCE_PSAM=/path/to/1000g_phase3/all_phase3.psam
AIM_LIST=/path/to/ancestry_informative_snps.txt
STUDY_INPUT_OPTION=--vcf
STUDY_INPUT=/secure/path/to/study_genotypes.vcf.gz

# Reference outputs
REFERENCE_OUTPUT_DIR=/secure/work/global_reference
AUTOSOMAL_PREFIX="${REFERENCE_OUTPUT_DIR}/reference_autosomal"
PRUNE_PREFIX="${REFERENCE_OUTPUT_DIR}/reference_prune"
LD_PRUNED_PREFIX="${REFERENCE_OUTPUT_DIR}/reference_ld_pruned"
REFERENCE_Q="${LD_PRUNED_PREFIX}.${K}.Q"
REFERENCE_FAM="${LD_PRUNED_PREFIX}.fam"
REFERENCE_KEEP="${REFERENCE_OUTPUT_DIR}/reference_selected.keep"
REFERENCE_LABELS="${REFERENCE_OUTPUT_DIR}/reference_selected.labels.tsv"

# Joint-dataset outputs
JOINT_OUTPUT_DIR=/secure/work/global_joint
REFERENCE_AIMS_PREFIX="${JOINT_OUTPUT_DIR}/reference_aims"
REFERENCE_CANONICAL_PREFIX="${JOINT_OUTPUT_DIR}/reference_canonical"
STUDY_CANONICAL_PREFIX="${JOINT_OUTPUT_DIR}/study_canonical"
REFERENCE_IDS="${JOINT_OUTPUT_DIR}/reference_variant_ids.txt"
STUDY_IDS="${JOINT_OUTPUT_DIR}/study_variant_ids.txt"
SHARED_IDS="${JOINT_OUTPUT_DIR}/shared_variant_ids.txt"
REFERENCE_SHARED_PREFIX="${JOINT_OUTPUT_DIR}/reference_shared"
STUDY_SHARED_PREFIX="${JOINT_OUTPUT_DIR}/study_shared"
JOINT_PREFIX="${JOINT_OUTPUT_DIR}/joint"
JOINT_FAM="${JOINT_PREFIX}.fam"
JOINT_POP="${JOINT_PREFIX}.pop"
